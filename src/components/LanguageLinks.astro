---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { content, locales, type Locale } from '../i18n/content';

interface Props {
  locale: Locale;
  /** Path without a language prefix, such as "" or "work/qa-automation/". */
  path?: string;
}

const { locale, path = '' } = Astro.props;
const labels = content[locale].languages;
---

{
  locales.map((l) => (
    <a
      href={getRelativeLocaleUrl(l, path)}
      lang={l}
      aria-label={labels[l]}
      aria-current={l === locale ? 'true' : undefined}
    >
      {l.toUpperCase()}
    </a>
  ))
}
