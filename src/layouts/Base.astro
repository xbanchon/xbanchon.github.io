---
import { getAbsoluteLocaleUrl } from 'astro:i18n';
import '@fontsource-variable/bricolage-grotesque/opsz.css';
import '@fontsource-variable/newsreader/opsz.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '../styles/global.css';
import { locales, type Locale } from '../i18n/content';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  /** Path without a language prefix, such as "" or "work/qa-automation/". */
  path?: string;
  noindex?: boolean;
}

const { locale, title, description, path = '', noindex = false } = Astro.props;
const canonical = getAbsoluteLocaleUrl(locale, path);
const skipLabel = locale === 'es' ? 'Saltar al contenido' : 'Skip to content';
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {
      !noindex && (
        <>
          <link rel="canonical" href={canonical} />
          {locales.map((l) => (
            <link rel="alternate" hreflang={l} href={getAbsoluteLocaleUrl(l, path)} />
          ))}
          <link rel="alternate" hreflang="x-default" href={getAbsoluteLocaleUrl('en', path)} />
          <meta property="og:type" content="website" />
          <meta property="og:title" content={title} />
          <meta property="og:description" content={description} />
          <meta property="og:url" content={canonical} />
          <meta property="og:locale" content={locale === 'es' ? 'es_EC' : 'en_US'} />
        </>
      )
    }
  </head>
  <body>
    <a class="skip-link" href="#main">{skipLabel}</a>
    <slot />
  </body>
</html>
